          "name": "total",
          "type": "DECIMAL(10, 2)"
        },
        {
          "name": "delivery_address",
          "type": "STRING"
        },
        {
          "name": "event_time",
          "type": "TIMESTAMP(3)"
        }
      ],
      "pk": [],
      "watermark": {
        "column": "event_time",
        "expr": "event_time - INTERVAL '1' SECOND"
      },
      "options": {
        "connector": "kafka",
        "topic": "orders"
